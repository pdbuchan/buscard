<deviceset name="COMMODORE_PARALLEL_PORT_CARD_EDGE" prefix="P" uservalue="yes">
<description>&lt;p&gt;&lt;b&gt;Commodore 26-Contact (13 top + 13 bottom) Parallel Port Card-Edge.&lt;/b&gt;&lt;/p&gt;
&lt;p&gt;Contacts are 0.05" x 0.35" on a 0.1" pitch.&lt;/p&gt;
&lt;p&gt;Numbering alternates between top and bottom, with contact 1 at bottom. Contacts 1 and 2 are on same end of card-edge.&lt;/p&gt;
&lt;p&gt;There is a 0.05" gap between contacts 21/22 and 23/24.&lt;/p&gt;
&lt;p&gt;Card edge protrudes 0.55" from main circuit board.&lt;/p&gt;</description>
<gates>
<gate name="G$1" symbol="COMMODORE_PARALLEL_PORT_CARD_EDGE" x="0" y="0"/>
