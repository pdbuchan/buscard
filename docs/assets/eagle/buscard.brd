<library name="female-44-pin-edge-connector">
<packages>
<package name="FEMALE_44-PIN_CARD_EDGE_CONNECTOR">
<description>&lt;p&gt;&lt;b&gt;Female Connector for Commodore 64 44-Contact (22 top + 22 bottom) Expansion Port Card-Edge.&lt;/b&gt;&lt;/p&gt;
&lt;p&gt;Contacts are on a 0.1" (2.54 mm) pitch.&lt;/p&gt;
&lt;p&gt;Row pitch is 0.2" (5.08 mm).&lt;/p&gt;
&lt;p&gt;Contacts are numbered 1 to 22 on top and A to Z on bottom (excludes G, I, O, and Q). Contacts 1 and A are on same end of card-edge.&lt;/p&gt;
&lt;p&gt;Accepts board thickness of 0.062" (1.57 mm).&lt;/p&gt;</description>
