<deviceset name="COMMODORE_IEEE-488_PORT_CARD_EDGE" prefix="P">
<description>&lt;p&gt;&lt;b&gt;Commodore 24-Contact (12 top + 12 bottom) IEEE-488 Port Card-Edge.&lt;/b&gt;&lt;/p&gt;
&lt;p&gt;Contacts are 0.09" x 0.35" on a 0.156" pitch.&lt;/p&gt;
&lt;p&gt;Contacts are numbered 1 to 12 on top and A to N on bottom (excludes G and I). Contacts 1 and A are on same end of card-edge.&lt;/p&gt;
&lt;p&gt;There is a 0.066" gap between contacts 2/B and 3/C and 9/K and10/L.&lt;/p&gt;
&lt;p&gt;Card edge protrudes 0.55" from main circuit board.&lt;/p&gt;</description>
<gates>
<gate name="G$1" symbol="COMMODORE_IEEE-488_PORT_CARD_EDGE" x="0" y="2.54"/>
